From 1294f56f999b38d9a81285f70018ca48a9ff207b Mon Sep 17 00:00:00 2001
From: Kisaragi Hiu <mail@kisaragi-hiu.com>
Date: Tue, 6 Oct 2026 18:38:47 +0900
Subject: [PATCH] patch: do not install fonts

An input method should not provide fonts just for fallback.
---
 linux/Makefile | 7 +------
 1 file changed, 1 insertion(+), 6 deletions(-)

diff --git a/linux/Makefile b/linux/Makefile
index fea1e34..a1bb099 100644
--- a/linux/Makefile
+++ b/linux/Makefile
@@ -35,3 +35,3 @@ LAYOUT ?= debian
 # (its `licenses` package) and Debian (common-licenses) already hold.
-LICENSE_TEXTS := ../NOTICE ../THIRD_PARTY_LICENSES.md ../assets/fonts/OFL-1.1.txt ../dictionary/LICENSE
+LICENSE_TEXTS := ../NOTICE ../THIRD_PARTY_LICENSES.md ../dictionary/LICENSE
 ifeq ($(LAYOUT),debian)
@@ -173,7 +173,2 @@ install: build component install-fcitx5
 	done
-	# The bundled typefaces (the ones macOS and Windows ship), as fontconfig
-	# fallbacks for the Han characters the desktop's fonts lack (roadmap L4);
-	# users pick them in Fcitx5 / IBus (L7).
-	install -Dm644 -t $(DESTDIR)$(FONTDIR_TTF) ../assets/fonts/font/*.ttf
-	install -Dm644 -t $(DESTDIR)$(FONTDIR_OTF) ../assets/fonts/font/*.otf
 ifeq ($(LAYOUT),debian)
-- 
2.56.0

