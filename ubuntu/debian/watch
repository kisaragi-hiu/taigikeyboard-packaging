# Rename this file to "watch" and then you can run the "uscan" command to check
# for upstream updates and more. See uscan(1) for format.
Version: 5

# We cannot use Template: Github, because we need to specifify a tag prefix.
# Custom-Version is not available as that was added in uscan 2.26.8 but current
# latest in Ubuntu 26.04 is 2.26.7.
# This is copied from https://manpages.debian.org/unstable/devscripts/debian-watch.5.en.html#GitHub
Source: https://api.github.com/repos/@PACKAGE@/@PACKAGE@/git/matching-refs/tags/desktop
Matching-Pattern: https://api.github.com/repos/[^/]+/[^/]+/git/refs/tags/desktop-@ANY_VERSION@
Download-Url-Mangle: s%(api.github.com/repos/[^/]+/[^/]+)/git/refs/%$1/tarball/refs/%g
Filename-Mangle: s%.*/@ANY_VERSION@%@PACKAGE@-$1.tar.gz%
Search-Mode: plain
