#!/usr/bin/make -f

%:
	dh $@

override_dh_clean:
	true

override_dh_auto_build:
	# support a local build without vendoring
	if [ -d debian/vendor ]; then mkdir -p linux/.cargo; fi
	if [ -d debian/vendor ]; then cp debian/cargo.config.toml linux/.cargo/config.toml; fi
	if [ -d debian/vendor ]; then mv debian/vendor linux/vendor; fi
	dh_auto_build -- -C linux build
	dh_auto_build -- -C linux component
	dh_auto_build -- -C linux build-fcitx5

# There is a test expected to fail which is only ignored in the GitHub Actions
# workflow. Really, just don't bother running tests here.
override_dh_auto_test:
	true

override_dh_auto_install:
	dh_auto_install -- -C linux INSTALL_FONTS=0
