#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_build:
	cd linux && make build
	cd linux && make component
	cd linux && make build-fcitx5

# There is a test expected to fail which is only ignored in the GitHub Actions
# workflow. Really, just don't bother running tests here.
override_dh_auto_test:
	true
